      <!-- Main Mailto Button -->
      <div class="flex flex-col items-center justify-center">
        <div class="bg-gradient-to-br from-brand-50 to-purple-50 dark:from-brand-900/20 dark:to-purple-900/20 rounded-2xl p-8 border-2 border-brand-200 dark:border-brand-800 w-full max-w-md text-center">
          <!-- Decorative Icon -->
          <div class="w-20 h-20 bg-brand-500 rounded-full flex items-center justify-center mx-auto mb-6 shadow-lg shadow-brand-500/30">
            <svg class="w-10 h-10 text-white" fill="currentColor" viewBox="0 0 24 24">
