          <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">Reach out to us directly via email</p>
          <a href="mailto:teamlazycoder@gmail.com" 
             class="text-brand-500 hover:text-brand-600 font-medium transition-colors break-all">
            teamlazycoder@gmail.com
          </a>
        </div>

        <div class="contact-info-card">
          <div class="w-12 h-12 rounded-xl bg-brand-100 dark:bg-brand-900/30 flex items-center justify-center text-brand-500 mb-4">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </div>
          <h3 class="font-display font-700 text-gray-900 dark:text-white mb-1">GitHub</h3>
          <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">Check out our open-source projects</p>
          <a href="https://github.com/teamlazycoder" target="_blank" 
             class="text-brand-500 hover:text-brand-600 font-medium transition-colors">
            github.com/teamlazycoder
          </a>
        </div>

        <div class="contact-info-card">
          <div class="w-12 h-12 rounded-xl bg-brand-100 dark:bg-brand-900/30 flex items-center justify-center text-brand-500 mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <h3 class="font-display font-700 text-gray-900 dark:text-white mb-1">Location</h3>
          <p class="text-sm text-gray-500 dark:text-gray-400">Maharashtra, India 🇮🇳</p>
        </div>
