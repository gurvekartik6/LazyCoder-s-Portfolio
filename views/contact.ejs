          <p class="text-gray-500 dark:text-gray-400 text-sm mb-6">
            We'll get back to you within 24 hours
          </p>

          <!-- Main Mailto Button -->
          <a href="mailto:teamlazycoder@gmail.com?subject=Inquiry%20from%20Portfolio&body=Hello%20LazyCoders%20Team%2C%0A%0A"
             class="w-full inline-flex items-center justify-center gap-3 px-6 py-4 bg-brand-500 hover:bg-brand-600 text-white rounded-xl font-semibold text-lg transition-all duration-300 hover:shadow-xl hover:scale-[1.02] group">
            <svg class="w-6 h-6 transition-transform duration-300 group-hover:scale-110" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
            </svg>
            Open Email App
          </a>

          <p class="text-xs text-gray-400 dark:text-gray-500 mt-4">
            Opens your default email application
          </p>

          <!-- Email Display -->
          <div class="mt-6 pt-6 border-t border-gray-200 dark:border-dark-600">
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">Our Email Address</p>
            <p class="font-mono text-brand-500 font-medium text-sm break-all">
              teamlazycoder@gmail.com
            </p>
          </div>
        </div>

        <!-- Quick Copy Button -->
        <button onclick="copyEmail()" 
                class="mt-4 inline-flex items-center gap-2 px-4 py-2 text-sm text-gray-500 dark:text-gray-400 hover:text-brand-500 dark:hover:text-brand-400 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
          </svg>
          Copy Email Address
        </button>
      </div>
    </div>
  </div>
</section>

<script>
function copyEmail() {
  const email = "teamlazycoder@gmail.com";
  navigator.clipboard.writeText(email).then(() => {
    const btn = event.target.closest('button');
    const originalText = btn.innerHTML;
    btn.innerHTML = `
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
      </svg>
      Copied!
    `;
    btn.classList.add('text-green-500');
    setTimeout(() => {
      btn.innerHTML = originalText;
      btn.classList.remove('text-green-500');
    }, 2000);
  });
}
</script>

